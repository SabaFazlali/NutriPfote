<%- include('partials/head', { title: 'Produktvergleich - NutriPfote' }) %>
<%- include('partials/header') %>

<main class="container py-5">
    <h1>Produktvergleich</h1>
    <p class="mb-4">Vergleichen Sie unsere Premium-Produkte auf einen Blick.</p>

    <% if (products && products.length > 0) { %>
        <div class="compare-table-container">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th>Eigenschaft</th>
                        <% products.forEach(product => { %>
                            <th>
                                <div class="compare-product-head">
                                    <img src="<%= product.image %>" alt="<%= product.name %>" class="compare-img">
                                    <h4><%= product.name %></h4>
                                    <button class="btn btn-sm btn-outline remove-compare" data-id="<%= product.id %>">Entfernen</button>
                                </div>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Kategorie / Tierart</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.category || 'Futter' %> / <%= product.animalType === 'dog' ? 'Hund' : (product.animalType === 'cat' ? 'Katze' : product.animalType) %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Lebensphase</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.lifeStage %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Zweck</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.purpose %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Proteine</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.nutrition ? product.nutrition.protein : 'k.A.' %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Fett</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.nutrition ? product.nutrition.fat : 'k.A.' %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Packungen / Preise</strong></td>
                        <% products.forEach(product => { %>
                            <td>
                                <%= product.variants.map(variant => variant.size + ' - €' + variant.price.toFixed(2)).join(', ') %>
                            </td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Lagerbestand</strong></td>
                        <% products.forEach(product => { %>
                            <td><%= product.variants.reduce((sum, variant) => sum + Number(variant.stock || 0), 0) %> Packungen</td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Allergie-Tags</strong></td>
                        <% products.forEach(product => { %>
                            <td>
                                <div class="tag-list">
                                    <% product.allergyTags.forEach(tag => { %>
                                        <span class="tag"><%= tag %></span>
                                    <% }) %>
                                </div>
                            </td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td><strong>Weitere Nährwerte</strong></td>
                        <% products.forEach(product => { %>
                            <td>Faser: <%= product.nutrition && product.nutrition.fiber ? product.nutrition.fiber : 'k.A.' %>, Verdaulichkeit: <%= product.nutrition && product.nutrition.digestibility ? product.nutrition.digestibility : 'k.A.' %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <td></td>
                        <% products.forEach(product => { %>
                            <td>
                                <a href="/product/<%= product.id %>" class="btn btn-primary btn-block">Details</a>
                            </td>
                        <% }) %>
                    </tr>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state py-5">
            <div class="empty-icon">⚖️</div>
            <h2>Keine Produkte zum Vergleich ausgewählt</h2>
            <p>Fügen Sie bis zu 3 Produkte aus unserem Shop zum Vergleich hinzu.</p>
            <a href="/shop" class="btn btn-primary">Zum Shop</a>
        </div>
    <% } %>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const idsInUrl = urlParams.get('ids');
        const compareList = JSON.parse(localStorage.getItem('compare') || '[]');

        // If we have items in localStorage but not in URL, redirect
        if (!idsInUrl && compareList.length > 0) {
            window.location.href = '/compare?ids=' + compareList.join(',');
            return;
        }

        // Handle "Remove" button
        document.querySelectorAll('.remove-compare').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const newList = compareList.filter(item => item !== id);
                localStorage.setItem('compare', JSON.stringify(newList));
                window.location.href = newList.length > 0 ? '/compare?ids=' + newList.join(',') : '/compare';
            });
        });
    });
</script>

<%- include('partials/cart') %>
<%- include('partials/footer') %>
