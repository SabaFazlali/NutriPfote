<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutriPfote - Premium Pet Food</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="main-header">
        <div class="container">
            <a href="/" class="logo">
                <span class="logo-icon">🐾</span> NutriPfote
            </a>
            <nav class="main-nav">
                <ul>
                    <li><a href="/" class="active">Home</a></li>
                    <li><a href="#">Shop</a></li>
                    <li><a href="#">Guides</a></li>
                    <li><a href="#">About Us</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="btn-icon" aria-label="Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                </button>
            </div>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container hero-content">
                <h2>Nourish Your Pet With Nature's Best</h2>
                <p>Discover our premium selection of organic, eco-friendly pet food tailored for your furry friend's unique needs.</p>
                <a href="#shop" class="btn-primary hero-btn">Explore Shop</a>
            </div>
        </section>

        <section id="shop" class="products-section container">
            <div class="section-header">
                <h3>Our Premium Selection</h3>
                <p>Carefully crafted recipes for optimal health and vitality</p>
            </div>
            
            <div id="products-container" class="products-grid">
                <!-- Products will be dynamically loaded here by main.js -->
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading healthy choices...</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="main-footer">
        <div class="container footer-content">
            <div class="footer-brand">
                <h4>🐾 NutriPfote</h4>
                <p>Premium pet nutrition for a healthier, happier life.</p>
            </div>
            <div class="footer-links">
                <p>&copy; <%= new Date().getFullYear() %> NutriPfote. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- JS module -->
    <script type="module" src="/js/main.js"></script>
</body>
</html>
