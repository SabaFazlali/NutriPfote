<div class="layout-wrapper">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <a href="/" class="logo">
            <img src="/img/favicon.png" alt="NutriPfote Logo" style="height: 32px; width: auto;"> NutriPfote
        </a>
        
        <nav class="main-nav" id="main-nav">
            <ul>
                <li><a href="/" class="<%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">Startseite</a></li>
                <li><a href="/shop" class="<%= typeof activePage !== 'undefined' && activePage === 'shop' ? 'active' : '' %>">Shop</a></li>
                <li><a href="/guides" class="<%= typeof activePage !== 'undefined' && activePage === 'guides' ? 'active' : '' %>">Ratgeber</a></li>
                <li><a href="/consultation" class="<%= typeof activePage !== 'undefined' && activePage === 'consultation' ? 'active' : '' %>">Beratung</a></li>
                <li><a href="/about" class="<%= typeof activePage !== 'undefined' && activePage === 'about' ? 'active' : '' %>">Über uns</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="main-content">
        <!-- Topbar for actions -->
        <header class="topbar">
            <div class="header-right">
                <div class="header-actions">
                    <a href="/compare" class="btn-icon" title="Vergleich">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"></path><path d="M4 20L21 3"></path><path d="M21 16v5h-5"></path><path d="M15 15l6 6"></path><path d="M4 4l5 5"></path></svg>
                    </a>
                    
                    <button class="btn-icon" id="cart-trigger" aria-label="Cart" title="Warenkorb">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        <span id="cart-count" class="cart-count-badge" style="display: none;">0</span>
                    </button>

                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="/profile" class="btn-icon" title="Mein Profil">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn-icon" title="Anmelden">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                        </a>
                    <% } %>
                </div>

                <button class="menu-toggle" id="menu-toggle" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
            </div>
        </header>
