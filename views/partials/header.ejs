<header class="main-header">
    <div class="container">
        <a href="/" class="logo">
            <img src="/img/favicon.png" alt="NutriPfote Logo" style="height: 32px; width: auto;"> NutriPfote
        </a>
        
        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle navigation">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <nav class="main-nav" id="main-nav">
            <ul>
                <li><a href="/" class="<%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">Startseite</a></li>
                <li><a href="/#shop">Shop</a></li>
                <li><a href="/guides" class="<%= typeof activePage !== 'undefined' && activePage === 'guides' ? 'active' : '' %>">Ratgeber</a></li>
                <li><a href="/about" class="<%= typeof activePage !== 'undefined' && activePage === 'about' ? 'active' : '' %>">Über uns</a></li>
            </ul>
        </nav>
        
        <div class="header-actions">
            <button class="btn-icon" id="cart-trigger" aria-label="Cart">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span id="cart-count" class="cart-count-badge" style="display: none;">0</span>
            </button>
        </div>
    </div>
</header>
