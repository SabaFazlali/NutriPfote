<!DOCTYPE html>
<html lang="de">
<%- include('partials/head', { title: product.name }) %>
<style>
    .product-detail-section {
        padding: 4rem 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }
    .product-visual {
        background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
        border-radius: var(--border-radius-lg);
        height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .product-info h1 {
        font-size: 2.5rem;
        color: var(--primary-dark);
        margin-bottom: 1rem;
    }
    .product-info .product-desc {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
        line-height: 1.8;
    }
    .product-meta {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background-color: var(--surface-color);
        border-radius: var(--border-radius-md);
        box-shadow: var(--shadow-sm);
    }
    .meta-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding-bottom: 0.5rem;
    }
    .meta-item:last-child {
        margin-bottom: 0;
        border-bottom: none;
        padding-bottom: 0;
    }
    .meta-label {
        font-weight: 600;
        color: var(--text-main);
    }
    .meta-value {
        color: var(--text-muted);
        text-transform: capitalize;
    }
    .variants-section {
        margin-bottom: 2rem;
    }
    .variants-section h3 {
        margin-bottom: 1rem;
        font-size: 1.2rem;
    }
    .variants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 1rem;
    }
    .variant-card {
        border: 2px solid var(--tag-bg);
        border-radius: var(--border-radius-sm);
        padding: 1rem;
        text-align: center;
        cursor: pointer;
        transition: var(--transition-fast);
    }
    .variant-card:hover, .variant-card.selected {
        border-color: var(--primary-color);
        background-color: rgba(26, 67, 49, 0.05);
    }
    .variant-size {
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: block;
    }
    .variant-price {
        color: var(--primary-color);
        font-weight: 600;
    }
    .variant-stock {
        display: block;
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }
    .detail-block {
        background: var(--surface-color);
        border-radius: var(--border-radius-md);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .detail-block h3 {
        margin-bottom: 1rem;
        color: var(--primary-dark);
    }
    .feeding-table {
        width: 100%;
        border-collapse: collapse;
    }
    .feeding-table td {
        padding: 0.75rem;
        border-bottom: 1px solid #E2E8F0;
    }
    .add-to-cart-container {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
    .btn-large {
        flex-grow: 1;
        padding: 1rem;
        font-size: 1.2rem;
        border-radius: var(--border-radius-md);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
    }
    .breadcrumb {
        margin-bottom: 2rem;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    .breadcrumb a {
        color: var(--primary-color);
        text-decoration: none;
    }
    .breadcrumb a:hover {
        text-decoration: underline;
    }

    @media (max-width: 1024px) {
        .product-detail-section {
            gap: 2rem;
        }
        .product-info h1 {
            font-size: 2rem;
        }
    }

    @media (max-width: 768px) {
        .product-detail-section {
            grid-template-columns: 1fr;
            padding: 2rem 0;
        }
        .product-visual {
            height: 350px;
        }
        .product-info h1 {
            font-size: 1.75rem;
        }
        .add-to-cart-container {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            padding: 1rem;
            margin-top: 0;
            box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
            z-index: 100;
        }
        main {
            padding-bottom: 80px;
        }
    }
</style>
<body>
    <%- include('partials/header', { activePage: 'shop' }) %>

    <main>
        <section class="container product-detail-section">
            <div class="product-visual">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                <% } else { %>
                    <span class="animal-type-label" style="font-size: 2rem; font-weight: 700; color: var(--text-muted);"><%= product.animalType === 'dog' ? 'Hund' : 'Katze' %></span>
                <% } %>
                <div class="product-badge" style="top: 1rem; right: 1rem; font-size: 0.8rem; padding: 0.4rem 1rem; position: absolute;"><%= product.animalType === 'dog' ? 'Hund' : (product.animalType === 'cat' ? 'Katze' : product.animalType) %></div>
            </div>
            
            <div class="product-info">
                <div class="breadcrumb">
                    <a href="/">Startseite</a> &rsaquo; <a href="/#shop">Shop</a> &rsaquo; <%= product.name %>
                </div>
                
                <h1><%= product.name %></h1>

                <!-- Available options, quantity selection and buy button at the top -->
                <div class="variants-section">
                    <h3>Verfügbare Optionen</h3>
                    <div class="variants-grid">
                        <% product.variants.forEach((variant, index) => { %>
                            <div class="variant-card <%= index === 0 ? 'selected' : '' %>" data-size="<%= variant.size %>" data-price="<%= variant.price %>" data-stock="<%= variant.stock %>">
                                <span class="variant-size"><%= variant.size %></span>
                                <span class="variant-price">€<%= variant.price.toFixed(2) %></span>
                                <span class="variant-stock"><%= variant.stock > 0 ? variant.stock + ' auf Lager' : 'Nicht auf Lager' %></span>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="detail-block">
                    <h3>Ausgewaehlte Packung</h3>
                    <p id="selected-variant-text"><%= product.variants[0].size %> fuer €<%= product.variants[0].price.toFixed(2) %></p>
                </div>

                <div class="add-to-cart-container" style="display: flex; gap: 1rem; align-items: flex-end; margin-top: 1.5rem; margin-bottom: 2.5rem;">
                    <div class="form-group" style="margin-bottom: 0; width: 100px;">
                        <label for="qty-input" style="font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 0.25rem;">Menge</label>
                        <input type="number" id="qty-input" value="1" min="1" max="100" style="padding: 0.75rem; border: 1px solid #E2E8F0; border-radius: var(--border-radius-sm); text-align: center; width: 100%;">
                    </div>
                    <button id="add-to-cart-btn" class="btn-primary btn-large" style="flex-grow: 1; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; height: 47px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        In den Warenkorb
                    </button>
                </div>

                <hr style="border: 0; border-top: 1px solid rgba(0,0,0,0.08); margin-bottom: 2rem;">

                <!-- Product description and tags below -->
                <p class="product-desc"><%= product.description %></p>
                
                <div class="product-tags" style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <% product.allergyTags.forEach(tag => { %>
                        <span class="tag"><%= tag %></span>
                    <% }); %>
                    <% if (product.ecoFriendly) { %>
                        <span class="tag eco">Umweltfreundlich</span>
                    <% } %>
                </div>

                <div class="product-meta">
                    <div class="meta-item">
                        <span class="meta-label">Lebensphase</span>
                        <span class="meta-value"><%= product.lifeStage %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Zweck</span>
                        <span class="meta-value"><%= product.purpose.replace('-', ' ') %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Geeignet für</span>
                        <span class="meta-value"><%= product.weightClasses.join(', ') %> Rassen</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Verdaulichkeit</span>
                        <span class="meta-value"><%= product.nutrition && product.nutrition.digestibility ? product.nutrition.digestibility : 'k.A.' %></span>
                    </div>
                </div>

                <div class="detail-block">
                    <h3>Fütterungsempfehlung pro Gewichtsklasse</h3>
                    <table class="feeding-table">
                        <tbody>
                            <% (product.feedingAmounts || []).forEach(row => { %>
                                <tr>
                                    <td><strong><%= row.weightClass %></strong></td>
                                    <td><%= row.amount %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <div class="detail-block">
                    <h3>Hinweise</h3>
                    <p><strong>Fütterung:</strong> <%= product.feedingInstructions || 'Bitte langsam umstellen und die Futtermenge anpassen.' %></p>
                    <p><strong>Pflege:</strong> <%= product.careInstructions || 'Kuehl und trocken lagern.' %></p>
                </div>

                <% if (relatedGuides && relatedGuides.length > 0) { %>
                    <div class="detail-block">
                        <h3>Passende Ratgeber</h3>
                        <div class="link-list">
                            <% relatedGuides.forEach(guide => { %>
                                <a href="/guide/<%= guide.id %>"><%= guide.title %></a>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/cart') %>

    <!-- JS module -->
    <script type="module" src="/js/main.js"></script>

    <script type="module">
        document.addEventListener('DOMContentLoaded', () => {
            // Variant selection
            const variantCards = document.querySelectorAll('.variant-card');
            variantCards.forEach(card => {
                card.addEventListener('click', () => {
                    variantCards.forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    const selectedText = document.getElementById('selected-variant-text');
                    selectedText.textContent = `${card.dataset.size} fuer €${Number(card.dataset.price).toFixed(2)} (${card.dataset.stock} auf Lager)`;
                });
            });

            const addToCartBtn = document.getElementById('add-to-cart-btn');
            if (addToCartBtn) {
                addToCartBtn.addEventListener('click', () => {
                    const selectedVariant = document.querySelector('.variant-card.selected');
                    const price = selectedVariant 
                        ? parseFloat(selectedVariant.querySelector('.variant-price').textContent.replace('€', ''))
                        : <%= product.variants[0].price %>;
                    const qtyVal = parseInt(document.getElementById('qty-input').value) || 1;
                    
                    window.addToCart({
                        id: '<%= product.id %>',
                        name: '<%= product.name %>',
                        price: price,
                        variant: selectedVariant ? selectedVariant.dataset.size : '<%= product.variants[0].size %>'
                    }, qtyVal);
                    
                    addToCartBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Hinzugefügt!';
                    setTimeout(() => {
                        addToCartBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg> In den Warenkorb';
                    }, 2000);
                });
            }
        });
    </script>
</body>
</html>
