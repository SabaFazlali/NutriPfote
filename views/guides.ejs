<!DOCTYPE html>
<html lang="de">
<%- include('partials/head', { title: 'Ratgeber' }) %>
<style>
    .guides-hero {
        padding: 6rem 0;
        background: linear-gradient(rgba(26, 67, 49, 0.8), rgba(26, 67, 49, 0.8)), url('/img/hero-bg.jpg');
        background-size: cover;
        background-position: center;
        border-radius: 0 0 50px 50px;
        text-align: center;
        color: white;
        margin-bottom: 5rem;
    }
    .guides-hero h2 {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        letter-spacing: -0.03em;
    }
    .guides-hero p {
        font-size: 1.3rem;
        opacity: 0.9;
        max-width: 600px;
        margin: 0 auto;
    }
    .guide-card {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 0;
        background-color: var(--surface-color);
        border-radius: var(--border-radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        margin-bottom: 4rem;
        transition: var(--transition-normal);
    }
    .guide-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-8px);
    }
    .guide-image-container {
        position: relative;
        overflow: hidden;
    }
    .guide-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--transition-slow);
    }
    .guide-card:hover .guide-image {
        transform: scale(1.05);
    }
    .guide-body {
        padding: 3rem;
    }
    .guide-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .guide-topic-badge {
        background-color: var(--primary-color);
        color: white;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .guide-animal-type {
        font-size: 0.9rem;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: capitalize;
    }
    .guide-title {
        font-size: 2rem;
        color: var(--primary-dark);
        margin-bottom: 1.2rem;
        line-height: 1.3;
    }
    .guide-summary {
        font-size: 1.2rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
        font-weight: 600;
        line-height: 1.5;
    }
    .guide-content {
        color: var(--text-main);
        line-height: 1.9;
        font-size: 1.05rem;
    }
    @media (max-width: 850px) {
        .guide-card {
            grid-template-columns: 1fr;
        }
        .guide-image-container {
            height: 250px;
        }
        .guide-body {
            padding: 2rem;
        }
    }
    @media (max-width: 768px) {
        .guides-hero {
            padding: 4rem 0;
            border-radius: 0 0 30px 30px;
        }
        .guides-hero h2 {
            font-size: 2.5rem;
        }
        .guides-hero p {
            font-size: 1.1rem;
        }
        .guide-title {
            font-size: 1.5rem;
        }
        .guide-summary {
            font-size: 1.1rem;
        }
    }
</style>
<body>
    <%- include('partials/header', { activePage: 'guides' }) %>
 
    <main>
        <section class="guides-hero">
            <div class="container">
                <h2>Haustierpflege-Ratgeber</h2>
                <p>Umfassendes Wissen für ein vitales und langes Haustierleben – direkt von unseren Experten.</p>
            </div>
        </section>
 
        <section class="container" style="max-width: 1000px;">
            <div class="guides-list">
                <% if (guides && guides.length > 0) { %>
                    <% guides.forEach(guide => { %>
                        <a href="/guide/<%= guide.id %>" style="text-decoration: none; color: inherit; display: block;">
                            <article class="guide-card">
                                <div class="guide-image-container">
                                    <img src="<%= guide.image || '/img/hero-bg.jpg' %>" alt="<%= guide.title %>" class="guide-image">
                                </div>
                                <div class="guide-body">
                                    <div class="guide-header">
                                        <span class="guide-topic-badge"><%= guide.topic %></span>
                                        <span class="guide-animal-type"><%= guide.animalType === 'dog' ? 'Hunde' : 'Katzen' %></span>
                                    </div>
                                    <h3 class="guide-title"><%= guide.title %></h3>
                                    <p class="guide-summary"><%= guide.summary %></p>
                                    <div class="guide-content">
                                        <p><%= guide.content.substring(0, 150) %>...</p>
                                    </div>
                                </div>
                            </article>
                        </a>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <p>Zur Zeit sind keine Ratgeber verfügbar.</p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/cart') %>

    <!-- JS module -->
    <script type="module" src="/js/main.js"></script>
</body>
</html>
