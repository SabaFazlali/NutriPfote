<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <h1>Shop-Team Dashboard</h1>
        <p class="mb-4">Angemeldet als <strong><%= user.name %></strong> (Administrator) | <a href="/logout" style="color: #C53030; font-weight: 600; text-decoration: none;">Abmelden &rarr;</a></p>

        <!-- Dashboard Metrics Counters -->
        <div class="admin-grid" style="margin-bottom: 3rem; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
            <div class="admin-card" style="text-align: center; padding: 2rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); transition: var(--transition-fast);">
                <span style="font-size: 3rem; font-weight: 800; color: var(--primary-color); display: block; line-height: 1;"><%= products.length %></span>
                <strong style="font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem; display: block;">Produkte</strong>
            </div>
            <div class="admin-card" style="text-align: center; padding: 2rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); transition: var(--transition-fast);">
                <span style="font-size: 3rem; font-weight: 800; color: var(--primary-color); display: block; line-height: 1;"><%= guides.length %></span>
                <strong style="font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem; display: block;">Ratgeber</strong>
            </div>
            <div class="admin-card" style="text-align: center; padding: 2rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); transition: var(--transition-fast);">
                <span style="font-size: 3rem; font-weight: 800; color: var(--primary-color); display: block; line-height: 1;"><%= orders.length %></span>
                <strong style="font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem; display: block;">Bestellungen</strong>
            </div>
            <div class="admin-card" style="text-align: center; padding: 2rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); transition: var(--transition-fast);">
                <span style="font-size: 3rem; font-weight: 800; color: var(--primary-color); display: block; line-height: 1;"><%= questions.length %></span>
                <strong style="font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem; display: block;">Anfragen</strong>
            </div>
        </div>

        <h2 style="margin-bottom: 1.5rem; color: var(--primary-dark); border-bottom: 2px solid var(--tag-bg); padding-bottom: 0.5rem;">Administration &amp; CMS</h2>
        <div class="admin-grid" style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
            <a href="/admin/products" class="admin-card" style="padding: 1.5rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid var(--primary-color);">
                <strong style="font-size: 1.1rem; color: var(--primary-dark);">Produkte verwalten</strong>
                <span style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Preise, Bilder, Varianten und Details bearbeiten</span>
            </a>
            <a href="/admin/guides" class="admin-card" style="padding: 1.5rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid var(--primary-color);">
                <strong style="font-size: 1.1rem; color: var(--primary-dark);">Ratgeber verwalten</strong>
                <span style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Gesundheitsthemen, Allergiehinweise und Tipps verfassen</span>
            </a>
            <a href="/admin/orders" class="admin-card" style="padding: 1.5rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid var(--primary-color);">
                <strong style="font-size: 1.1rem; color: var(--primary-dark);">Bestellungen ansehen</strong>
                <span style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Eingegangene Bestellungen und Status verfolgen</span>
            </a>
            <a href="/admin/questions" class="admin-card" style="padding: 1.5rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid var(--primary-color);">
                <strong style="font-size: 1.1rem; color: var(--primary-dark);">Beratungsanfragen</strong>
                <span style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Nachrichten von Tierhaltern beantworten</span>
            </a>
            <a href="/admin/cms" class="admin-card" style="padding: 1.5rem; background: var(--surface-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid var(--accent-color);">
                <strong style="font-size: 1.1rem; color: var(--primary-dark);">CMS-Inhalte bearbeiten</strong>
                <span style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Titel und Banner-Texte der Seiten anpassen</span>
            </a>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
