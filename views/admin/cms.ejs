<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin CMS - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <div class="admin-header">
            <div>
                <h1>CMS-Inhalte bearbeiten</h1>
                <p>Verwalten Sie Titel, Beschreibungstexte und Hintergrundbilder für Hauptseiten.</p>
            </div>
            <a href="/admin" class="btn-outline">Zurueck</a>
        </div>

        <form method="POST" action="/admin/cms" class="admin-form" style="grid-template-columns: 1fr;">
            <!-- Startseite section -->
            <div class="detail-block full" style="margin-bottom: 2rem;">
                <h3 style="border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">Startseite</h3>
                <div class="form-group">
                    <label>Titel (Hero)</label>
                    <input name="homeTitle" value="<%= cmsData.home.title %>" required>
                </div>
                <div class="form-group">
                    <label>Beschreibung (Hero)</label>
                    <textarea name="homeDesc" rows="3" required><%= cmsData.home.description %></textarea>
                </div>
                <div class="form-group">
                    <label>Bildpfad (Hero)</label>
                    <input name="homeImage" value="<%= cmsData.home.image %>" required>
                </div>
            </div>

            <!-- Shop section -->
            <div class="detail-block full" style="margin-bottom: 2rem;">
                <h3 style="border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">Shop Seite</h3>
                <div class="form-group">
                    <label>Titel</label>
                    <input name="shopTitle" value="<%= cmsData.shop.title %>" required>
                </div>
                <div class="form-group">
                    <label>Beschreibung</label>
                    <textarea name="shopDesc" rows="3" required><%= cmsData.shop.description %></textarea>
                </div>
                <div class="form-group">
                    <label>Bildpfad (Hero)</label>
                    <input name="shopImage" value="<%= cmsData.shop.image %>" required>
                </div>
            </div>

            <!-- Guides section -->
            <div class="detail-block full" style="margin-bottom: 2rem;">
                <h3 style="border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">Ratgeber Seite</h3>
                <div class="form-group">
                    <label>Titel</label>
                    <input name="guidesTitle" value="<%= cmsData.guides.title %>" required>
                </div>
                <div class="form-group">
                    <label>Beschreibung</label>
                    <textarea name="guidesDesc" rows="3" required><%= cmsData.guides.description %></textarea>
                </div>
                <div class="form-group">
                    <label>Bildpfad (Hero)</label>
                    <input name="guidesImage" value="<%= cmsData.guides.image %>" required>
                </div>
            </div>

            <div class="form-group full">
                <button class="btn-primary" type="submit" style="width: 100%; padding: 1rem; font-size: 1.1rem;">CMS-Inhalte speichern</button>
            </div>
        </form>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
