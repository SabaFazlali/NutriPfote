<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin Produkte - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <div class="admin-header">
            <div>
                <h1>Produkte verwalten</h1>
                <p>Varianten: eine pro Zeile oder mit Komma, Format <code>Groesse|Preis|Lager</code>.</p>
            </div>
            <a href="/admin" class="btn-outline">Zurueck</a>
        </div>

        <div style="margin-bottom: 2rem;">
            <button id="toggleProductForm" class="btn-primary" style="margin-bottom: 1rem;"><%= mode === 'edit' ? 'Formular ausblenden' : 'Neues Produkt anlegen' %></button>
            <div id="productFormContainer" style="display: <%= mode === 'edit' ? 'block' : 'none' %>; padding: 1.5rem; background: #fff; border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm);">
                <form method="POST" action="<%= mode === 'edit' ? '/admin/products/' + product.id + '/edit' : '/admin/products' %>" class="admin-form">
            <div class="form-group"><label>Name</label><input name="name" value="<%= product ? product.name : '' %>" required></div>
            <div class="form-group"><label>Tierart</label><select name="animalType"><option value="dog" <%= product && product.animalType === 'dog' ? 'selected' : '' %>>Hund</option><option value="cat" <%= product && product.animalType === 'cat' ? 'selected' : '' %>>Katze</option><option value="horse" <%= product && product.animalType === 'horse' ? 'selected' : '' %>>Pferd</option><option value="small" <%= product && product.animalType === 'small' ? 'selected' : '' %>>Kleintiere</option></select></div>
            <div class="form-group"><label>Kategorie</label><input name="category" value="<%= product ? product.category : 'Trockenfutter' %>"></div>
            <div class="form-group"><label>Lebensphase</label><input name="lifeStage" value="<%= product ? product.lifeStage : '' %>" required></div>
            <div class="form-group"><label>Gewichtsklassen kommagetrennt</label><input name="weightClasses" value="<%= product ? product.weightClasses.join(', ') : '' %>"></div>
            <div class="form-group"><label>Zweck</label><input name="purpose" value="<%= product ? product.purpose : '' %>" required></div>
            <div class="form-group"><label>Allergie-Tags kommagetrennt</label><input name="allergyTags" value="<%= product ? product.allergyTags.join(', ') : '' %>"></div>
            <div class="form-group"><label>Kurzbeschreibung</label><input name="shortDescription" value="<%= product ? product.shortDescription : '' %>"></div>
            <div class="form-group"><label>Bildpfad</label><input name="image" value="<%= product ? product.image : '/img/hero-bg.jpg' %>"></div>
            <div class="form-group full"><label>Beschreibung</label><textarea name="description" rows="3"><%= product ? product.description : '' %></textarea></div>
            <div class="form-group full"><label>Varianten</label><textarea name="variants" rows="3"><%= product ? product.variants.map(v => v.size + '|' + v.price + '|' + v.stock).join(', ') : '1 kg|9.99|5' %></textarea></div>
            <div class="form-group"><label>Protein</label><input name="protein" value="<%= product && product.nutrition ? product.nutrition.protein : '' %>"></div>
            <div class="form-group"><label>Fett</label><input name="fat" value="<%= product && product.nutrition ? product.nutrition.fat : '' %>"></div>
            <div class="form-group"><label>Faser</label><input name="fiber" value="<%= product && product.nutrition ? product.nutrition.fiber : '' %>"></div>
            <div class="form-group"><label>Verdaulichkeit</label><input name="digestibility" value="<%= product && product.nutrition ? product.nutrition.digestibility : '' %>"></div>
            <div class="form-group full"><label>Futtermenge Format <code>Klasse|Menge</code></label><textarea name="feedingAmounts" rows="2"><%= product && product.feedingAmounts ? product.feedingAmounts.map(row => row.weightClass + '|' + row.amount).join(', ') : '' %></textarea></div>
            <div class="form-group full"><label>Fütterungshinweise</label><textarea name="feedingInstructions" rows="2"><%= product ? product.feedingInstructions : '' %></textarea></div>
            <div class="form-group full"><label>Pflegehinweise</label><textarea name="careInstructions" rows="2"><%= product ? product.careInstructions : '' %></textarea></div>
            <div class="form-group"><label>Ratgeber IDs</label><input name="guideIds" value="<%= product ? product.guideIds.join(', ') : '' %>"></div>
            <div class="form-group checkbox-line"><label><input type="checkbox" name="ecoFriendly" <%= product && product.ecoFriendly ? 'checked' : '' %>> Umweltfreundlich</label></div>
                    <button class="btn-primary" type="submit"><%= mode === 'edit' ? 'Produkt speichern' : 'Produkt anlegen' %></button>
                </form>
            </div>
        </div>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Tierart</th>
                        <th>Kategorie</th>
                        <th>Lebensphase</th>
                        <th>Größe</th>
                        <th>Preis</th>
                        <th>Lager</th>
                        <th>Eco</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.name %></strong></td>
                            <td style="text-transform: capitalize;"><%= item.animalType === 'dog' ? 'Hund' : (item.animalType === 'cat' ? 'Katze' : item.animalType) %></td>
                            <td><%= item.category || 'Futter' %></td>
                            <td><%= item.lifeStage %></td>
                            <td><%- item.variants.map(v => v.size).join('<br>') %></td>
                            <td><%- item.variants.map(v => '€' + v.price.toFixed(2)).join('<br>') %></td>
                            <td><%- item.variants.map(v => v.stock + ' Stk.').join('<br>') %></td>
                            <td><%= item.ecoFriendly ? 'Ja' : 'Nein' %></td>
                            <td>
                                <div style="display: flex; gap: 0.25rem;">
                                    <a href="/admin/products/<%= item.id %>/edit" class="btn-icon" title="Bearbeiten">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                    </a>
                                    <form action="/admin/products/<%= item.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Möchten Sie dieses Produkt wirklich löschen?');">
                                        <button class="btn-icon" type="submit" title="Löschen" style="color: #c53030;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script>
        const toggleBtn = document.getElementById('toggleProductForm');
        const formContainer = document.getElementById('productFormContainer');
        if (toggleBtn && formContainer) {
            toggleBtn.addEventListener('click', () => {
                if (formContainer.style.display === 'none') {
                    formContainer.style.display = 'block';
                    toggleBtn.textContent = 'Formular ausblenden';
                } else {
                    formContainer.style.display = 'none';
                    toggleBtn.textContent = 'Neues Produkt anlegen';
                }
            });
        }
    </script>
</body>
</html>
