<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin Bestellungen - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <div class="admin-header">
            <h1>Bestellungen</h1>
            <a href="/admin" class="btn-outline">Zurueck</a>
        </div>
        <div class="admin-table-container">
            <% if (orders.length === 0) { %>
                <div class="empty-state" style="border: none; box-shadow: none;"><p>Noch keine Bestellungen vorhanden.</p></div>
            <% } else { %>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Bestell-ID</th>
                            <th>Kunde &amp; Kontakt</th>
                            <th>Artikelanzahl</th>
                            <th>Gesamtsumme</th>
                            <th>Status</th>
                            <th>Datum / Uhrzeit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><strong><%= order.id %></strong></td>
                                <td>
                                    <%= order.customer.fullName %><br>
                                    <span style="font-size: 0.85rem; color: var(--text-muted);"><%= order.customer.email %></span>
                                </td>
                                <td><%= order.items.length %> Artikel</td>
                                <td><strong>€<%= Number(order.total || 0).toFixed(2) %></strong></td>
                                <td>
                                    <span class="badge <%= order.status === 'completed' || order.status === 'abgeschlossen' ? 'badge-completed' : 'badge-pending' %>">
                                        <%= order.status %>
                                    </span>
                                    <form action="/admin/orders/<%= order.id %>/status" method="POST" style="margin-top: 5px;">
                                        <select name="status" onchange="this.form.submit()" style="padding: 2px 5px; font-size: 0.8rem;">
                                            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                            <option value="completed" <%= order.status === 'completed' || order.status === 'abgeschlossen' ? 'selected' : '' %>>Completed</option>
                                        </select>
                                    </form>
                                </td>
                                <td><%= new Date(order.date).toLocaleString('de-DE') %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
