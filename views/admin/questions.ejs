<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin Anfragen - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <div class="admin-header">
            <h1>Beratungsanfragen</h1>
            <a href="/admin" class="btn-outline">Zurueck</a>
        </div>
        <div class="admin-table-container">
            <% if (questions.length === 0) { %>
                <div class="empty-state" style="border: none; box-shadow: none;"><p>Noch keine Anfragen vorhanden.</p></div>
            <% } else { %>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Kunde</th>
                            <th>Kontakt</th>
                            <th>Tier / Thema</th>
                            <th>Nachricht</th>
                            <th>Wunschtermin</th>
                            <th>Status</th>
                            <th>Datum / Uhrzeit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% questions.forEach(question => { %>
                            <tr>
                                <td><strong><%= question.name %></strong></td>
                                <td><%= question.email %></td>
                                <td>
                                    <span style="text-transform: capitalize;"><%= question.animalType === 'dog' ? 'Hund' : (question.animalType === 'cat' ? 'Katze' : question.animalType) %></span> / 
                                    <span><%= question.topic %></span>
                                </td>
                                <td><div style="max-width: 300px; font-size: 0.9rem; line-height: 1.4; white-space: normal; word-break: break-word;"><%= question.message %></div></td>
                                <td><%= question.preferredTime || 'Kein Wunschtermin' %></td>
                                <td>
                                    <form action="/admin/questions/<%= question.id %>/status" method="POST" style="margin: 0;">
                                        <select name="status" onchange="this.form.submit()" class="badge <%= question.status === 'beantwortet' || question.status === 'answered' || question.status === 'Answered' ? 'badge-completed' : 'badge-pending' %>" style="border: 1px solid transparent; cursor: pointer; outline: none; font-family: inherit; font-size: inherit; appearance: none; -webkit-appearance: none; padding-right: 1.5rem; background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23000000%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right .7rem top 50%; background-size: .65rem auto;">
                                            <option value="Neu" <%= question.status === 'Neu' ? 'selected' : '' %>>Neu</option>
                                            <option value="Answered" <%= question.status === 'Answered' || question.status === 'beantwortet' || question.status === 'answered' ? 'selected' : '' %>>Answered</option>
                                        </select>
                                    </form>
                                </td>
                                <td><%= new Date(question.date).toLocaleString('de-DE') %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
