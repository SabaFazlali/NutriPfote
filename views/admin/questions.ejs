<!DOCTYPE html>
<html lang="de">
<%- include('../partials/head', { title: 'Admin Anfragen - NutriPfote' }) %>
<body>
    <%- include('../partials/header', { activePage: 'admin' }) %>
    <main class="container py-5">
        <div class="admin-header">
            <h1>Beratungsanfragen</h1>
            <a href="/admin" class="btn-outline">Zurueck</a>
        </div>
        <div class="admin-table-container">
            <% if (questions.length === 0) { %>
                <div class="empty-state" style="border: none; box-shadow: none;"><p>Noch keine Anfragen vorhanden.</p></div>
            <% } else { %>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Kunde</th>
                            <th>Kontakt</th>
                            <th>Tier / Thema</th>
                            <th>Nachricht</th>
                            <th>Wunschtermin</th>
                            <th>Status</th>
                            <th>Datum / Uhrzeit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% questions.forEach(question => { %>
                            <tr>
                                <td><strong><%= question.name %></strong></td>
                                <td><%= question.email %></td>
                                <td>
                                    <span style="text-transform: capitalize;"><%= question.animalType === 'dog' ? 'Hund' : (question.animalType === 'cat' ? 'Katze' : question.animalType) %></span> / 
                                    <span><%= question.topic %></span>
                                </td>
                                <td><div style="max-width: 300px; font-size: 0.9rem; line-height: 1.4; white-space: normal; word-break: break-word;"><%= question.message %></div></td>
                                <td><%= question.preferredTime || 'Kein Wunschtermin' %></td>
                                <td>
                                    <span class="badge <%= question.status === 'beantwortet' || question.status === 'answered' || question.status === 'Answered' ? 'badge-completed' : 'badge-pending' %>">
                                        <%= question.status %>
                                    </span>
                                    <form action="/admin/questions/<%= question.id %>/status" method="POST" style="margin-top: 5px;">
                                        <select name="status" onchange="this.form.submit()" style="padding: 2px 5px; font-size: 0.8rem;">
                                            <option value="Neu" <%= question.status === 'Neu' ? 'selected' : '' %>>Neu</option>
                                            <option value="Answered" <%= question.status === 'Answered' || question.status === 'beantwortet' || question.status === 'answered' ? 'selected' : '' %>>Answered</option>
                                        </select>
                                    </form>
                                </td>
                                <td><%= new Date(question.date).toLocaleString('de-DE') %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
